APP_NAME=laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=maya
DB_USERNAME=default
DB_PASSWORD=secret

CACHE_DRIVER=redis
FILESYSTEM_DRIVER=local

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://meilisearch:7700

APP_SERVICE="${APP_NAME}.test"
COMPOSE_PROJECT_NAME="${APP_NAME}"
NODE_VERSION=14.19.3
WWWGROUP=1000
WWWUSER=1000
SAIL_XDEBUG_MODE=develop,debug
