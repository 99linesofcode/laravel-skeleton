# This should be equal to docker-base APP_NAME
APP_NAME=laravel-skeleton
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

BROADCAST_DRIVER=pusher
CACHE_DRIVER=redis
FILESYSTEM_DRIVER=local

# This should be equal to docker-base database service name
DB_HOST=mysql
DB_PORT=3306
# This should be equal to docker-base DB_DATABASE
DB_DATABASE=laravel-skeleton
DB_USERNAME=default
DB_PASSWORD=secret

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# This should be equal to docker-base mailpit service name
MAIL_HOST=mailpit
MAIL_MAILER=smtp
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

# This should be equal to docker-base meilisearch service name and port
MEILISEARCH_HOST=http://meilisearch:7700
# This should be equal to docker-base meilisearch service name
SCOUT_DRIVER=meilisearch

# This should be equal to docker-base soketi service name
PUSHER_HOST=soketi
PUSHER_APP_ID=app-id
PUSHER_APP_KEY=app-key
PUSHER_APP_SECRET=app-secret
PUSHER_SCHEME=http
PUSHER_APP_CLUSTER=mt1
PUSHER_FRONTEND_HOST=localhost
PUSHER_FRONTEND_CLUSTER="${PUSHER_APP_CLUSTER}"

#
# Kamal deployment environment variables
#

MYSQL_ROOT_PASSWORD=${DB_PASSWORD}
MYSQL_DATABASE=${DB_DATABASE}
MYSQL_USER=${DB_USERNAME}
MYSQL_PASSWORD=${DB_PASSWORD}

SOKETI_DEBUG=-1
SOKETI_METRICS_SERVER_PORT=9601
SOKETI_DEFAULT_APP_ID=${PUSHER_APP_ID}
SOKETI_DEFAULT_APP_KEY=${PUSHER_APP_KEY}
SOKETI_DEFAULT_APP_SECRET=${PUSHER_APP_SECRET}
