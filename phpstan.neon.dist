parameters:
    level: 5
    paths:
        - app
        - src
        - database
        - tests
    tmpDir: build/phpstan
    ignoreErrors:
        # Pest binds a test closure's $this to the test case at run time and
        # forwards arch() calls to its expectations; PHPStan sees only TestCall.
        -
            identifier: method.notFound
            message: '#^Call to an undefined method Pest\\PendingCalls\\TestCall::#'
            path: tests/*
