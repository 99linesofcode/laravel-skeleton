{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "99linesofcode/laravel-skeleton",
    "type": "project",
    "description": "",
    "keywords": [],
    "homepage": "https://github.com/99linesofcode",
    "license": "MIT",
    "authors": [
        {
            "name": "Jordy Schreuders",
            "email": "3071062+99linesofcode@users.noreply.github.com"
        }
    ],
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.7",
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "^3.9",
        "laravel/pint": "^1.29",
        "rector/rector": "^2.3",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^4.4",
        "pestphp/pest-plugin-browser": "^4.3",
        "pestphp/pest-plugin-faker": "^4.0",
        "pestphp/pest-plugin-livewire": "^4.1",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-mockery": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Lines\\Skeleton\\": "app/"
        },
        "classmap": [
            "database/factories",
            "database/seeders"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Lines\\Skeleton\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php -r \"file_exists('phpunit.xml') || copy('phpunit.xml.dist', 'phpunit.xml');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "pnpm install",
            "pnpm exec build"
        ],
        "analyse": "@php vendor/bin/phpstan analyse --memory-limit=2G --ansi",
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "pnpm exec concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"pnpm dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "ide-helper": [
            "@php artisan ide-helper:generate --ansi",
            "@php artisan ide-helper:meta --ansi",
            "@php artisan ide-helper:models -M --ansi"
        ],
        "lint": [
            "@php vendor/bin/pint --test -v --ansi",
            "@php vendor/bin/phpstan analyse --verbose --memory-limit=2G --ansi"
        ],
        "format": [
            "@php vendor/bin/pint --ansi",
            "@php vendor/bin/phpstan analyse --fix --memory-limit=2G --ansi",
            "@refactor"
        ],
        "refactor": "@php vendor/bin/rector --memory-limit=2G --ansi"
    },
    "extra": {
        "laravel": {
            "providers": [],
            "aliases": [],
            "dont-discover": []
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
